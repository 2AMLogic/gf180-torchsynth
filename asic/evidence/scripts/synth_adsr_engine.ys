# Commit-safe form (issue #1870): the liberty below is written relative
# to $PDK_ROOT, which Yosys does NOT expand -- this file is the artifact
# to commit, not the one to run. Run the rehydrated sibling
# 'synth_adsr_engine.run.ys' (regenerated by every `klt synthesize` run), or
# substitute your own PDK install root for $PDK_ROOT first.
read_verilog asic/build/src/gf180_rtl_constants_pkg.sv
read_verilog asic/build/src/adsr_engine.sv
hierarchy -check -top adsr_engine
synth -top adsr_engine
dfflibmap -liberty $PDK_ROOT/ciel/gf180mcu/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_5v00.lib
tee -q -o asic/build/req/.klt/synthesize/r1792015096-adsrengine/adsr_engine_abc.log abc -liberty $PDK_ROOT/ciel/gf180mcu/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_5v00.lib -constr asic/build/req/.klt/synthesize/r1792015096-adsrengine/adsr_engine_abc.constr -D 40000
clean
setundef -zero
hilomap -hicell gf180mcu_fd_sc_mcu7t5v0__tieh Z -locell gf180mcu_fd_sc_mcu7t5v0__tiel ZN
tee -q -o asic/build/req/.klt/synthesize/r1792015096-adsrengine/adsr_engine_stats.json stat -liberty $PDK_ROOT/ciel/gf180mcu/versions/f6eeac7dad085ffcc829ccfd721f7b4ce39edcf7/gf180mcuD/libs.ref/gf180mcu_fd_sc_mcu7t5v0/lib/gf180mcu_fd_sc_mcu7t5v0__tt_025C_5v00.lib -json -top adsr_engine
write_verilog -noattr asic/build/req/.klt/synthesize/r1792015096-adsrengine/adsr_engine_synth.v
