# generated by tools/synth_feasibility_ltp.py for adsr_engine (check C4);
# unmapped flow: no PDK, no liberty, no abc, no mapping.
read_verilog asic/build/ltp/src/gf180_rtl_constants_pkg.sv
read_verilog asic/build/ltp/src/adsr_engine.sv
hierarchy -top adsr_engine
synth -run :fine -flatten
tee -o asic/build/ltp/results/adsr_engine.ltp.txt ltp -noff
tee -o asic/build/ltp/results/adsr_engine.stat.txt stat
select t:$mul t:$div t:$mod t:$divfloor t:$modfloor
write_json -selected asic/build/ltp/results/adsr_engine.arith.json
