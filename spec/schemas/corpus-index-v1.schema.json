{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2amlogic.github.io/gf180-torchsynth/schemas/corpus-index-v1.schema.json",
  "title": "Portable TorchSynth corpus index v1",
  "description": "One preregistered case per global sound index; semantic count, uniqueness and identity checks also required.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "torchsynth-corpus-index"
    },
    "schema_version": {
      "const": 1
    },
    "corpus_id": {
      "$ref": "render-artifact-v1.schema.json#/$defs/id"
    },
    "corpus_manifest_sha256": {
      "$ref": "render-artifact-v1.schema.json#/$defs/sha256"
    },
    "profile": {
      "const": "torchsynth-1-voice-default"
    },
    "runtime_lock_sha256": {
      "$ref": "render-artifact-v1.schema.json#/$defs/sha256"
    },
    "status": {
      "enum": [
        "complete",
        "failed"
      ]
    },
    "expected_case_count": {
      "$ref": "render-artifact-v1.schema.json#/$defs/integer"
    },
    "observed_case_count": {
      "$ref": "render-artifact-v1.schema.json#/$defs/integer"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "$ref": "render-artifact-v1.schema.json#/$defs/id"
          },
          "split": {
            "enum": [
              "development",
              "holdout"
            ]
          },
          "fixture": {
            "$ref": "render-artifact-v1.schema.json#/$defs/fixture"
          },
          "status": {
            "enum": [
              "complete",
              "failed"
            ]
          },
          "artifact": {
            "oneOf": [
              {
                "$ref": "render-artifact-v1.schema.json#/$defs/artifactReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "render-artifact-v1.schema.json#/$defs/id"
            },
            "uniqueItems": true
          },
          "failures": {
            "type": "array",
            "items": {
              "$ref": "render-artifact-v1.schema.json#/$defs/id"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "case_id",
          "split",
          "fixture",
          "status",
          "artifact",
          "warnings",
          "failures"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "render-artifact-v1.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "failures": {
      "type": "array",
      "items": {
        "$ref": "render-artifact-v1.schema.json#/$defs/id"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "schema_version",
    "corpus_id",
    "corpus_manifest_sha256",
    "profile",
    "runtime_lock_sha256",
    "status",
    "expected_case_count",
    "observed_case_count",
    "cases",
    "warnings",
    "failures"
  ],
  "additionalProperties": false
}
