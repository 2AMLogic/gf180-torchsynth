{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2amlogic.github.io/gf180-torchsynth/schemas/corpus-run-v1.schema.json",
  "title": "Immutable corpus run snapshot v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "torchsynth-corpus-run"
    },
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}(?![\\s\\S])"
    },
    "plan": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ref",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*(?![\\s\\S])"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ref",
        "sha256",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "admission": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "ref",
            "sha256",
            "size_bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "complete",
        "failed"
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "success": {
          "type": "integer",
          "minimum": 0
        },
        "failure": {
          "type": "integer",
          "minimum": 0
        },
        "attempt": {
          "type": "integer",
          "minimum": 0
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        },
        "resume": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "expected",
        "observed",
        "success",
        "failure",
        "attempt",
        "retry",
        "resume"
      ],
      "additionalProperties": false
    },
    "elapsed_seconds": {
      "oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
          },
          "kind": {
            "enum": [
              "render",
              "resume"
            ]
          },
          "status": {
            "enum": [
              "complete",
              "failed"
            ]
          },
          "artifact": {
            "oneOf": [
              {
                "$ref": "render-artifact-v1.schema.json#/$defs/artifactReference"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          },
          "elapsed_seconds": {
            "oneOf": [{"type": "number", "minimum": 0}, {"type": "null"}]
          },
          "receipt": {
            "type": "object",
            "description": "Portable attempt receipt (spec/CORPUS-RUNNER.md, Portable attempt receipts). Resume and interrupted attempts carry {}. Failed renders carry exactly error_type/message/message_sha256/message_status. Completed renders carry the backend receipt; a command must be marked command_representation=portable-placeholders-v1 and use <project-root>/<worker-output> mount placeholders. No key or string at any depth may contain a host path outside the declared field-scoped container roots. These semantic rules are enforced by validate_run (default receipt_policy portable-v1), not by this structural schema; historical-v1 verification of retained pre-#289 runs skips only them."
          }
        },
        "required": [
          "sequence",
          "case_id",
          "kind",
          "status",
          "artifact",
          "failure",
          "elapsed_seconds",
          "receipt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "plan",
    "index",
    "admission",
    "status",
    "counts",
    "elapsed_seconds",
    "attempts"
  ],
  "additionalProperties": false
}
