{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capability-evidence-v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "node_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
    },
    "node_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "upstream_commit": {
          "const": "2b0964d4c6c3d472a2a0d54d91b408caaeffca6d"
        },
        "project_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
        },
        "producer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
        },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z(?![\\s\\S])"
        },
        "runtime_lock": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])"
        }
      },
      "required": [
        "upstream_commit",
        "project_commit",
        "producer",
        "run_id",
        "recorded_at",
        "runtime_lock"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\r\\n\\u2028\\u2029]*\\S[^\\r\\n\\u2028\\u2029]*(?![\\s\\S])"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "engine": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
        },
        "layer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
        },
        "executed": {
          "type": "boolean"
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "log": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "check",
        "command",
        "engine",
        "layer",
        "scope",
        "executed",
        "exit_code",
        "log"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "PASS",
            "FAIL",
            "NO VERDICT"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[^\\r\\n\\u2028\\u2029]*\\S[^\\r\\n\\u2028\\u2029]*(?![\\s\\S])"
        }
      },
      "required": [
        "verdict",
        "reason"
      ],
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fault": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
          },
          "executed": {
            "type": "boolean"
          },
          "detected": {
            "type": "boolean"
          },
          "log": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "fault",
          "executed",
          "detected",
          "log"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
      }
    }
  },
  "required": [
    "schema_version",
    "node_id",
    "node_sha256",
    "provenance",
    "inputs",
    "dependencies",
    "execution",
    "result",
    "controls",
    "references"
  ],
  "additionalProperties": false
}
