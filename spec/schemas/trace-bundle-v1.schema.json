{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2amlogic.github.io/gf180-torchsynth/schemas/trace-bundle-v1.schema.json",
  "title": "Companion TorchSynth trace bundle and traced-corpus linkage v1",
  "description": "Structural schema for the two companion forms that live OUTSIDE completed artifact directories. Semantic checks live in trace_artifacts.py and spec/TRACE-ARTIFACTS.md. A bundle binds the validated #23 capture descriptors of one traced render to its immutable published artifact; the companion index pins exact v1 corpus-index bytes and the matching per-case bundles with full coverage. Neither form is an artifact identity, a self-authenticating digest, or a file inside the store's artifact namespace. Trace file references remain the closed v1 {ref, sha256, size_bytes} objects.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "torchsynth-trace-bundle"
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "complete"
        },
        "artifact": {
          "$ref": "render-artifact-v1.schema.json#/$defs/artifactReference"
        },
        "registry": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "pattern": "^tr1-[a-f0-9]{64}(?![\\s\\S])"
            },
            "sha256": {
              "$ref": "render-artifact-v1.schema.json#/$defs/sha256"
            },
            "ref": {
              "$ref": "render-artifact-v1.schema.json#/$defs/path"
            }
          },
          "required": [
            "token",
            "sha256",
            "ref"
          ],
          "additionalProperties": false
        },
        "fixture": {
          "$ref": "render-artifact-v1.schema.json#/$defs/fixture"
        },
        "requested_traces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "render-artifact-v1.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "traces": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "properties": {
              "file": {
                "$ref": "render-artifact-v1.schema.json#/$defs/file"
              },
              "encoding": {
                "const": "f32le"
              },
              "dtype": {
                "const": "float32"
              },
              "shape": {
                "type": "array",
                "items": {
                  "$ref": "render-artifact-v1.schema.json#/$defs/integer"
                }
              },
              "classification": {
                "enum": [
                  "scalar",
                  "control",
                  "audio"
                ]
              },
              "rate_hz": {
                "oneOf": [
                  {
                    "$ref": "render-artifact-v1.schema.json#/$defs/integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sample_count": {
                "oneOf": [
                  {
                    "$ref": "render-artifact-v1.schema.json#/$defs/integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "boundary": {
                "$ref": "render-artifact-v1.schema.json#/$defs/id"
              },
              "observation": {
                "enum": [
                  "observed",
                  "derived"
                ]
              },
              "capture_sha256": {
                "$ref": "render-artifact-v1.schema.json#/$defs/sha256"
              }
            },
            "required": [
              "file",
              "encoding",
              "dtype",
              "shape",
              "classification",
              "rate_hz",
              "sample_count",
              "boundary",
              "observation",
              "capture_sha256"
            ],
            "additionalProperties": false
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "compression": {
              "const": "none"
            }
          },
          "required": [
            "compression"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "render-artifact-v1.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "render-artifact-v1.schema.json#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema",
        "schema_version",
        "status",
        "artifact",
        "registry",
        "fixture",
        "requested_traces",
        "traces",
        "storage",
        "warnings",
        "failures"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "torchsynth-trace-companion-index"
        },
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "complete",
            "failed"
          ]
        },
        "registry": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "pattern": "^tr1-[a-f0-9]{64}(?![\\s\\S])"
            },
            "sha256": {
              "$ref": "render-artifact-v1.schema.json#/$defs/sha256"
            },
            "ref": {
              "$ref": "render-artifact-v1.schema.json#/$defs/path"
            }
          },
          "required": [
            "token",
            "sha256",
            "ref"
          ],
          "additionalProperties": false
        },
        "index": {
          "$ref": "render-artifact-v1.schema.json#/$defs/file"
        },
        "variant_index": {
          "oneOf": [
            {
              "$ref": "render-artifact-v1.schema.json#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "$ref": "render-artifact-v1.schema.json#/$defs/id"
              },
              "sound_index": {
                "$ref": "render-artifact-v1.schema.json#/$defs/integer"
              },
              "fixture": {
                "$ref": "render-artifact-v1.schema.json#/$defs/fixture"
              },
              "status": {
                "enum": [
                  "complete",
                  "failed"
                ]
              },
              "artifact": {
                "oneOf": [
                  {
                    "$ref": "render-artifact-v1.schema.json#/$defs/artifactReference"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bundle": {
                "oneOf": [
                  {
                    "$ref": "render-artifact-v1.schema.json#/$defs/file"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "render-artifact-v1.schema.json#/$defs/id"
                },
                "uniqueItems": true
              },
              "failures": {
                "type": "array",
                "items": {
                  "$ref": "render-artifact-v1.schema.json#/$defs/id"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "case_id",
              "sound_index",
              "fixture",
              "status",
              "artifact",
              "bundle",
              "warnings",
              "failures"
            ],
            "additionalProperties": false
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "compression": {
              "const": "none"
            }
          },
          "required": [
            "compression"
          ],
          "additionalProperties": false
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "render-artifact-v1.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "failures": {
          "type": "array",
          "items": {
            "$ref": "render-artifact-v1.schema.json#/$defs/id"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema",
        "schema_version",
        "status",
        "registry",
        "index",
        "variant_index",
        "cases",
        "storage",
        "warnings",
        "failures"
      ],
      "additionalProperties": false
    }
  ]
}
