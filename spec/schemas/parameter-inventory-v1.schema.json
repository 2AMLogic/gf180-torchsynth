{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned default Voice parameter inventory v1",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "source",
    "annotations_sha256",
    "parameter_count",
    "nebula_entry_count",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "profile": {
      "type": "string",
      "const": "torchsynth-1-voice-default"
    },
    "source": {
      "type": "object",
      "required": [
        "commit",
        "files",
        "manifest_sha256"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "annotations_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parameter_count": {
      "type": "integer",
      "const": 78
    },
    "nebula_entry_count": {
      "type": "integer",
      "const": 156
    },
    "parameters": {
      "type": "array",
      "minItems": 78,
      "maxItems": 78,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "annotation": {
      "type": "object",
      "required": [
        "unit",
        "meaning",
        "interpretation",
        "selector",
        "notes",
        "evidence"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "enum": [
            "seconds",
            "Hz",
            "radians",
            "semitones",
            "MIDI note",
            "dimensionless"
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "const": "continuous"
        },
        "selector": {
          "type": "string",
          "enum": [
            "none",
            "continuous_weight",
            "continuous_morph"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "object",
      "required": [
        "schema_version",
        "parameters"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/annotation"
          }
        }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "module",
        "module_class",
        "parameter",
        "torch_name",
        "minimum",
        "maximum",
        "curve",
        "symmetric",
        "source_description",
        "frozen_capable",
        "default_frozen",
        "forward_position",
        "randomization_position",
        "annotation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "module_class": {
          "type": "string",
          "minLength": 1
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "torch_name": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "curve": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "symmetric": {
          "type": "boolean"
        },
        "source_description": {
          "type": "string",
          "minLength": 1
        },
        "frozen_capable": {
          "type": "boolean",
          "const": true
        },
        "default_frozen": {
          "type": "boolean",
          "const": false
        },
        "forward_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 77
        },
        "randomization_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 77
        },
        "annotation": {
          "$ref": "#/$defs/annotation"
        }
      },
      "additionalProperties": false
    }
  }
}
